# Gere uma chave local: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_PELO_MENOS_32_CARACTERES
JWT_ALGORITHM=HS256
DATABASE_URL=sqlite:///./finchat.db
# PostgreSQL: postgresql+psycopg://usuario:senha@localhost:5432/finchat
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
# Ollama local: execute `ollama pull gemma3:4b` antes de iniciar a API fora do Docker.
LLM_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=30
# Porta publicada pelo Docker Compose; a execução Python local não usa este campo.
FINCHAT_PORT=8080
OLLAMA_PORT=11434
