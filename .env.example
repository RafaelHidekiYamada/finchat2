# Gere uma chave local: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_PELO_MENOS_32_CARACTERES
DATABASE_URL=sqlite:///./finchat.db
# PostgreSQL: postgresql+psycopg://usuario:senha@localhost:5432/finchat
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Porta publicada pelo Docker Compose; a execução Python local não usa este campo.
FINCHAT_PORT=8080
